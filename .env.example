# Copy this file to .env and replace the placeholder with a fresh key.
# .env is git-ignored; never commit a real key.
#
# This file IS tracked by git, so it must never contain a real key.
#
# The judge only. The deployed bot service needs no API key at all, because the
# production decision path is deterministic and LLM-free.
LLM_PROVIDER=gemini
LLM_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY

# The primary wording model. If it is overloaded, retired, or out of quota the
# provider falls back to the deterministic body rather than failing the tick.
# Measured 2026-04: gemini-3.5-flash returns HTTP 503 "high demand"
# consistently, while gemini-3.5-flash-lite serves reliably.
LLM_MODEL=gemini-3.5-flash-lite

# Optional. Comma-separated list of sibling models to fail over to.
# LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest

# Wall-clock budget for a wording attempt, capped at 12s internally.
LLM_TIMEOUT_SECONDS=12

# Set to 1 on hosts where IPv6 routing to Google is unreliable.
LLM_FORCE_IPV4=0

BOT_URL=http://127.0.0.1:8131
TEST_SCENARIO=full_evaluation
JUDGE_NOW=2026-04-26T10:30:00Z

# Check which NVIDIA models are actually live before a scored run; several
# model-specific NIM endpoints have been retired (HTTP 410).
#   python probe_nvidia_quick.py
