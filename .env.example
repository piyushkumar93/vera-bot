# Copy this file to .env and replace the placeholder with a fresh key.
# .env is git-ignored; never commit a real key.
#
# The judge only. The deployed bot service needs no API key at all, because the
# production decision path is deterministic and LLM-free.
LLM_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash

BOT_URL=http://127.0.0.1:8131
TEST_SCENARIO=full_evaluation
JUDGE_NOW=2026-04-26T10:30:00Z

# Check which NVIDIA models are actually live before a scored run; several
# model-specific NIM endpoints have been retired (HTTP 410).
#   python probe_nvidia_quick.py